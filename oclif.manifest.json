          "type": "option"
        },
        "url": {
          "description": "source URL glob (case-insensitive, supports * wildcard)",
          "name": "url",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "topic": {
          "char": "t",
          "description": "exact topic (case-insensitive)",
          "name": "topic",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "tags": {
          "char": "g",
          "description": "tags to require (must match all)",
          "name": "tags",
          "hasDynamicHelp": false,
          "multiple": true,
