          "name": "read-only",
          "allowNo": false,
          "type": "boolean"
        },
        "toon": {
          "description": "emit the same envelope as --json, encoded as TOON (fewer tokens); cannot be combined with --json",
          "name": "toon",
          "allowNo": false,
          "type": "boolean"
        },
        "older-than": {
          "description": "content age threshold (fetched_at, else validated_at), e.g. \"30d\"",
          "name": "older-than",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "inactive": {
          "description": "idle time threshold (validated_at, else fetched_at), e.g. \"14d\"",
