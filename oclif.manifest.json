    "config:get": {
      "aliases": [],
      "args": {
        "key": {
          "description": "the configuration key to read",
          "name": "key",
          "required": false
        }
      },
      "description": "Print a config value. Without --global/--local, shows the merged effective value, in precedence order: a per-command override flag (e.g. `fetch --storage`) > env var > project file > user file > built-in default.\n\nValid keys: storage (global|project), summary (conservative|balanced|aggressive).",
      "examples": [
        {
          "description": "get the effective storage mode",
          "command": "<%= config.bin %> config get storage"
        },
        {
          "description": "read only the project-level value",
          "command": "<%= config.bin %> config get storage --local"
        }
      ],
      "flags": {
        "json": {
          "description": "Format output as json.",
          "helpGroup": "GLOBAL",
          "name": "json",
          "allowNo": false,
          "type": "boolean"
        },
        "read-only": {
          "aliases": [
            "plan"
          ],
          "description": "(alias: --plan) block filesystem writes/deletes; network fetches still run; also honored via BONSAI_READ_ONLY/BONSAI_PLAN_MODE",
          "name": "read-only",
          "allowNo": false,
          "type": "boolean"
        },
        "toon": {
          "description": "emit the same envelope as --json, encoded as TOON (fewer tokens); cannot be combined with --json",
          "name": "toon",
          "allowNo": false,
          "type": "boolean"
        },
        "global": {
          "char": "g",
          "description": "read user-level config only",
          "name": "global",
          "allowNo": false,
          "type": "boolean"
        },
        "local": {
          "aliases": [
            "project"
          ],
          "charAliases": [
            "p"
          ],
          "description": "read project-level config only",
          "name": "local",
          "allowNo": false,
          "type": "boolean"
        }
      },
      "hasDynamicHelp": false,
      "hiddenAliases": [],
