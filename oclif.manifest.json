{
  "commands": {
    "fetch": {
      "aliases": [],
      "args": {
        "url": {
          "description": "HTTP(S) URL to research",
          "name": "url",
          "required": true
        }
      },
      "description": "Fetch a URL, convert the main content to Markdown, and cache compressed and detailed variants.\n\nUsually invoked as `bonsai <url>`; run `bonsai help fetch` for URL-form flags.",
      "examples": [
        {
          "description": "cache docs with detailed output, topic, tags, and TTL",
          "command": "<%= config.bin %> https://docs.nestjs.com/ --topic \"Backend Frameworks\" --tags \"Node\" --tags \"NestJS\" --format detailed --ttl 7d"
        },
        {
          "description": "cache a volatile page with compressed JSON output",
          "command": "<%= config.bin %> https://news.ycombinator.com/ --format compressed --ttl 2h --json"
        },
        {
          "description": "fetch multiple URLs in one batch (space-separated)",
          "command": "<%= config.bin %> https://docs.nestjs.com/ https://docs.nestjs.com/first-steps"
        }
      ],
      "flags": {
        "json": {
          "description": "Format output as json.",
          "helpGroup": "GLOBAL",
          "name": "json",
          "allowNo": false,
          "type": "boolean"
        },
        "read-only": {
          "aliases": [
            "plan"
          ],
          "description": "(alias: --plan) block filesystem writes/deletes; network fetches still run; also honored via BONSAI_READ_ONLY/BONSAI_PLAN_MODE",
          "name": "read-only",
          "allowNo": false,
          "type": "boolean"
        },
        "toon": {
          "description": "emit the same envelope as --json, encoded as TOON (fewer tokens); cannot be combined with --json",
          "name": "toon",
          "allowNo": false,
          "type": "boolean"
        },
        "topic": {
          "char": "t",
          "description": "main research topic for metadata (max 200 chars)",
          "name": "topic",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "tags": {
          "char": "g",
          "description": "taxonomic tags for this research (can be repeated, max 100 chars each)",
          "name": "tags",
          "hasDynamicHelp": false,
          "multiple": true,
          "type": "option"
        },
        "format": {
          "char": "f",
          "description": "output format",
          "name": "format",
          "default": "compressed",
          "hasDynamicHelp": false,
          "multiple": false,
          "options": [
            "compressed",
            "detailed"
          ],
          "type": "option"
        },
        "tier": {
          "description": "freshness tier policy",
          "name": "tier",
          "default": "standard",
          "hasDynamicHelp": false,
          "multiple": false,
          "options": [
            "stable",
            "standard",
            "volatile"
          ],
          "type": "option"
        },
        "ttl": {
          "char": "l",
          "description": "TTL duration for freshness (e.g. \"2h\", \"7d\", \"6m\")",
          "name": "ttl",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "max-age": {
          "description": "maximum cache age to accept (e.g. \"2h\", \"7d\", \"6m\")",
          "name": "max-age",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "force": {
          "description": "fetch fresh content, ignoring cached entries",
          "name": "force",
          "allowNo": false,
          "type": "boolean"
        },
        "dry-run": {
          "description": "fetch and validate without writing cache",
          "name": "dry-run",
          "allowNo": false,
          "type": "boolean"
        },
        "allow-stale": {
          "description": "suppress exit code 5 when stale cache is served within grace after failed revalidation",
          "name": "allow-stale",
          "allowNo": false,
          "type": "boolean"
        },
        "rendered": {
          "description": "use browser-rendered capture for dynamic pages",
          "name": "rendered",
          "allowNo": false,
          "type": "boolean"
        },
        "storage": {
          "description": "override where this result is cached (secrets always stored globally)",
          "name": "storage",
          "hasDynamicHelp": false,
          "multiple": false,
          "options": [
            "global",
            "project"
          ],
          "type": "option"
        }
      },
      "hasDynamicHelp": false,
      "hidden": true,
      "hiddenAliases": [],
      "id": "fetch",
      "pluginAlias": "@taurgis/bonsai",
      "pluginName": "@taurgis/bonsai",
      "pluginType": "core",
      "strict": false,
      "summary": "Fetch and cache URL research Markdown",
      "enableJsonFlag": true,
      "stdoutIsPrimaryData": true
    },
    "import": {
      "aliases": [],
      "args": {
        "url": {
          "description": "single source URL for single-source import",
          "name": "url",
          "required": false
        }
      },
      "description": "Store supplied Markdown under one URL or a multi-source research note, using the same freshness and storage metadata as fetched pages.",
      "examples": [
        {
          "description": "import detailed research for one URL from stdin",
          "command": "printf \"# My Article\\n\" | <%= config.bin %> import https://example.com/docs --stdin --ttl 7d"
        },
        {
          "description": "import a research note synthesized from multiple source URLs",
          "command": "echo \"# Synthesized\" | <%= config.bin %> import --stdin --topic \"React docs\" --source-url https://react.dev/a --source-url https://react.dev/b"
        },
        {
          "description": "import research from a Markdown file",
          "command": "<%= config.bin %> import https://example.com/docs --file path/to/notes.md"
        },
        {
          "description": "import research from stdin with the file placeholder",
          "command": "cat notes.md | <%= config.bin %> import https://example.com/docs --file -"
        }
      ],
      "flags": {
        "json": {
          "description": "Format output as json.",
          "helpGroup": "GLOBAL",
          "name": "json",
          "allowNo": false,
          "type": "boolean"
        },
        "read-only": {
          "aliases": [
            "plan"
          ],
          "description": "(alias: --plan) block filesystem writes/deletes; network fetches still run; also honored via BONSAI_READ_ONLY/BONSAI_PLAN_MODE",
          "name": "read-only",
          "allowNo": false,
          "type": "boolean"
        },
        "toon": {
          "description": "emit the same envelope as --json, encoded as TOON (fewer tokens); cannot be combined with --json",
          "name": "toon",
          "allowNo": false,
          "type": "boolean"
        },
        "stdin": {
          "description": "read Markdown from stdin",
          "name": "stdin",
          "allowNo": false,
          "type": "boolean"
        },
        "file": {
          "char": "f",
          "description": "Markdown file to import, or \"-\" for stdin",
          "name": "file",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "input-format": {
          "description": "input content format",
          "name": "input-format",
          "default": "detailed",
          "hasDynamicHelp": false,
          "multiple": false,
          "options": [
            "compressed",
            "detailed"
          ],
          "type": "option"
        },
        "topic": {
          "char": "t",
          "description": "main topic for this research note (max 200 chars)",
          "name": "topic",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "tags": {
          "char": "g",
          "description": "taxonomic tags (can be repeated, max 100 chars each)",
          "name": "tags",
          "hasDynamicHelp": false,
          "multiple": true,
          "type": "option"
        },
        "tier": {
          "description": "freshness tier policy",
          "name": "tier",
          "default": "standard",
          "hasDynamicHelp": false,
          "multiple": false,
          "options": [
            "stable",
            "standard",
            "volatile"
          ],
          "type": "option"
        },
        "source-url": {
          "description": "source URLs for multi-source import (can be repeated)",
          "name": "source-url",
          "hasDynamicHelp": false,
          "multiple": true,
          "type": "option"
        },
        "ttl": {
          "char": "l",
          "description": "TTL duration for imported note freshness (e.g. \"2h\", \"7d\", \"6m\")",
          "name": "ttl",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "dry-run": {
          "description": "validate import without writing cache",
          "name": "dry-run",
          "allowNo": false,
          "type": "boolean"
        },
        "storage": {
          "description": "override where this note is cached (secrets always stored globally)",
          "name": "storage",
          "hasDynamicHelp": false,
          "multiple": false,
          "options": [
            "global",
            "project"
          ],
          "type": "option"
        }
      },
      "hasDynamicHelp": false,
      "hiddenAliases": [],
      "id": "import",
      "pluginAlias": "@taurgis/bonsai",
      "pluginName": "@taurgis/bonsai",
      "pluginType": "core",
      "strict": true,
      "summary": "Import agent-supplied Markdown into cache",
      "enableJsonFlag": true,
      "stdoutIsPrimaryData": true
    },
