      "strict": false,
      "summary": "Inspect cached research metadata for a URL",
      "enableJsonFlag": true,
      "stdoutIsPrimaryData": true
    },
    "list": {
      "aliases": [],
      "args": {},
      "description": "List page-level cached artifacts with source URLs, topic, tags, freshness, capture method, and token estimates.",
      "examples": [
        {
          "description": "list cached entries",
          "command": "<%= config.bin %> list"
        },
        {
          "description": "list entries for a topic as JSON",
          "command": "<%= config.bin %> list --topic \"React Suspense\" --json"
        },
        {
          "description": "list fresh entries matching tags",
          "command": "<%= config.bin %> list --freshness fresh --tags node --tags url"
        },
        {
          "description": "list entries matching a URL glob",
          "command": "<%= config.bin %> list --url \"https://react.dev/*\""
        }
      ],
      "flags": {
        "json": {
          "description": "Format output as json.",
          "helpGroup": "GLOBAL",
          "name": "json",
          "allowNo": false,
          "type": "boolean"
        },
        "read-only": {
          "aliases": [
            "plan"
          ],
          "description": "(alias: --plan) block filesystem writes/deletes; network fetches still run; also honored via BONSAI_READ_ONLY/BONSAI_PLAN_MODE",
          "name": "read-only",
          "allowNo": false,
          "type": "boolean"
        },
        "toon": {
          "description": "emit the same envelope as --json, encoded as TOON (fewer tokens); cannot be combined with --json",
          "name": "toon",
          "allowNo": false,
          "type": "boolean"
        },
        "topic": {
          "char": "t",
          "description": "exact topic (case-insensitive)",
          "name": "topic",
          "hasDynamicHelp": false,
          "multiple": false,
          "type": "option"
        },
        "tags": {
          "char": "g",
          "description": "tags to require (must match all)",
          "name": "tags",
          "hasDynamicHelp": false,
          "multiple": true,
          "type": "option"
        },
        "url": {
          "description": "source URL glob (case-insensitive, supports * wildcard)",
          "name": "url",
          "hasDynamicHelp": false,
