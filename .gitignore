# Dependencies
node_modules/

# Compilation / build output
dist/
*.tgz
*.tsbuildinfo

# VitePress docs site build output and cache
docs/.vitepress/dist/
docs/.vitepress/cache/

# Test coverage
coverage/
*.lcov

# Logs
*.log
logs/

# Caches
.cache/
.fallow/
.eslintcache

# Derived search index (rebuilt on demand from cached artifacts)
**/.search-index.json

# Superseded artifact backups archived when a cache entry is overwritten
**/*.superseded.*.md

# IDEs and editors
.idea/
.vscode/
.DS_Store

# Nexus-managed agent files: sources are committed (.github/agents,
# .github/instructions, .agents/skills); per-IDE copies that
# `forward-nexus sync` regenerates from them stay local
.agents/*
!.agents/skills/
!.agents/skills/**
.claude/*
!.claude/skills/
!.claude/skills/**
.cursor/

# Agent specific local paths
.gemini/

# Temporary / testing artifacts
tmp/
/scratch/
fnr-contract-scratch/
fn-contract-config-home/
fn-contract-scratch/
