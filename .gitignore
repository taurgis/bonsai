# Dependencies
node_modules/

# Compilation / build output
dist/
*.tgz
*.tsbuildinfo

# VitePress docs site build output and cache
docs/.vitepress/dist/
docs/.vitepress/cache/

# Test coverage
coverage/
*.lcov

# Logs
*.log
logs/

# Caches
.cache/
.fallow/
.eslintcache

# Derived search index (rebuilt on demand from cached artifacts)
**/.search-index.json

# Superseded artifact backups archived when a cache entry is overwritten
**/*.superseded.*.md

# IDEs and editors
.idea/
.vscode/
.DS_Store

# Nexus-managed agent files: sources (.github/agents, .github/instructions,
# .agents/skills) and the per-IDE files forward-nexus generates from them are
# committed so every IDE works on a fresh clone; other agent-local state
# stays ignored. After editing a source, run `forward-nexus sync` and commit
# the regenerated files.
.agents/*
!.agents/skills/
!.agents/skills/**
!.agents/rules/
!.agents/rules/**
.claude/*
!.claude/skills/
!.claude/skills/**
!.claude/rules/
!.claude/rules/**
!.claude/agents/
!.claude/agents/**
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# Agent specific local paths
.gemini/

# Temporary / testing artifacts
tmp/
/scratch/
fnr-contract-scratch/
fn-contract-config-home/
fn-contract-scratch/
